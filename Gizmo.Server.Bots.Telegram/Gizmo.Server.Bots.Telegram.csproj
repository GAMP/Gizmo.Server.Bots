<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.*" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Resources.resx">
      <SubType>Designer</SubType>
      <CustomToolNamespace>Gizmo.Server.Bots.Telegram.Localization</CustomToolNamespace>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Gizmo.Shared: sibling submodule or NuGet -->
  <ItemGroup Condition="Exists('..\..\Gizmo.Shared\Gizmo.Shared.csproj')">
    <ProjectReference Include="..\..\Gizmo.Shared\Gizmo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\Gizmo.Shared\Gizmo.Shared.csproj')">
    <PackageReference Include="Gizmo.Shared" Version="1.0.13" />
  </ItemGroup>

  <!-- Gizmo.Server.Shared: sibling submodule or NuGet -->
  <ItemGroup Condition="Exists('..\..\Gizmo.Server.Shared\Gizmo.Server.Shared\Gizmo.Server.Shared.csproj')">
    <ProjectReference Include="..\..\Gizmo.Server.Shared\Gizmo.Server.Shared\Gizmo.Server.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\Gizmo.Server.Shared\Gizmo.Server.Shared\Gizmo.Server.Shared.csproj')">
    <PackageReference Include="Gizmo.Server.Shared" Version="1.0.7" />
  </ItemGroup>

  <!-- Gizmo.Web.Api.Models: sibling submodule or NuGet -->
  <ItemGroup Condition="Exists('..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj')">
    <ProjectReference Include="..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\Gizmo.Web.Api.Models\Gizmo.Web.Api.Models.csproj')">
    <PackageReference Include="Gizmo.Web.Api.Models" Version="1.0.10" />
  </ItemGroup>

  <!-- Gizmo.DAL: sibling submodule or NuGet -->
  <ItemGroup Condition="Exists('..\..\Gizmo.DAL\Gizmo.DAL\Gizmo.DAL.csproj')">
    <ProjectReference Include="..\..\Gizmo.DAL\Gizmo.DAL\Gizmo.DAL.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\Gizmo.DAL\Gizmo.DAL\Gizmo.DAL.csproj')">
    <PackageReference Include="Gizmo.DAL" Version="3.0.1" />
  </ItemGroup>

</Project>
